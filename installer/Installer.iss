; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
#define MyAppName "Azookey"
#define MyAppVersion "0.1.0-alpha.1"
#define MyAppPublisher "fkunn1326"
#define MyAppURL "https://github.com/fkunn1326/azooKey-Windows/"
; Program Files: the startup task runs launcher.exe with the highest available
; privileges, so its binaries must not be writable by the user. The directory
; is fixed (no directory page; another /DIR= is refused in PrepareToInstall).
#define MyAppDir "{autopf}\" + MyAppName
#define SettingsAppSetup "Azookey_0.1.0_x64-setup.exe"
#define SettingsAppSetupSource "../target/release/bundle/nsis/" + SettingsAppSetup
; Checked before the settings app's installer is run (Azookey_ExecuteDependency).
#define SettingsAppSetupSha256 GetSHA256OfFile(AddBackslash(SourcePath) + SettingsAppSetupSource)
#define Dependency_CustomExecute "Azookey_ExecuteDependency"

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{80B746D4-D74D-4345-8F81-47E06BCAB515}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
; Settings and learning data stay in %APPDATA%\Azookey.
DefaultDirName={#MyAppDir}
DisableDirPage=yes
; Older versions installed into %APPDATA%\Azookey; do not reuse that directory.
UsePreviousAppDir=no
; "ArchitecturesAllowed=x64compatible" specifies that Setup cannot run
; on anything but x64 and Windows 11 on Arm.
ArchitecturesAllowed=x64compatible
; "ArchitecturesInstallIn64BitMode=x64compatible" requests that the
; install be done in "64-bit mode" on x64 or Windows 11 on Arm,
; meaning it should use the native 64-bit Program Files directory and
; the 64-bit view of the registry.
ArchitecturesInstallIn64BitMode=x64compatible
DisableProgramGroupPage=yes
; Uncomment the following line to run in non administrative install mode (install for current user only).
;PrivilegesRequired=lowest
OutputDir=../build
OutputBaseFilename=azookey-setup
SolidCompression=yes
WizardStyle=modern
PrivilegesRequired=admin
; The IME DLLs are loaded by nearly every process (including svchost), so the
; Restart Manager check would stop on "Preparing to Install" asking to close
; them. The DLLs are replaced on restart (restartreplace) and our own
; processes are stopped in PrepareToInstall instead.
CloseApplications=no

[Languages]
Name: "japanese"; MessagesFile: "compiler:Languages\Japanese.isl"

[Files]
; restartreplace/uninsrestartdelete: the IME DLLs stay loaded in running apps,
; so replace/delete them on the next restart when they are in use.
Source: "../build/azookey_windows.dll"; DestDir: "{app}"; DestName: "azookey.dll"; Flags: ignoreversion regserver restartreplace uninsrestartdelete 64bit
Source: "../build/x86/azookey_windows.dll"; DestDir: "{app}"; DestName: "azookey32.dll"; Flags: ignoreversion regserver restartreplace uninsrestartdelete 32bit
Source: "../build/*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "{#SettingsAppSetupSource}"; Flags: dontcopy noencryption
Source: "./Azookey Startup.xml"; Flags: dontcopy noencryption
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Run]
Filename: "icacls"; \
  Parameters: """{app}\azookey.dll"" /grant ""*S-1-15-2-1:(RX)"""; \
  Description: "Grant Permission"; \
  Flags: runhidden postinstall runascurrentuser
Filename: "icacls"; \
  Parameters: """{app}\azookey32.dll"" /grant ""*S-1-15-2-1:(RX)"""; \
  Description: "Grant Permission"; \
  Flags: runhidden postinstall runascurrentuser

[UninstallRun]
Filename: "{sys}\schtasks.exe"; \
  Parameters: "/Delete /TN ""Azookey Startup"" /F"; \
  Flags: runhidden waituntilterminated

[UninstallDelete]
; Clean up the legacy launcher script created by older installers.
Type: files; Name: "{app}\launch.vbs"

[Code]
// Runs before the other PrepareToInstall implementations (they run in the
// order of definition), so nothing is installed or executed elevated for
// another directory, e.g. one given with /DIR= or /LOADINF=.
<event('PrepareToInstall')>
function Azookey_CheckAppDir(var NeedsRestart: Boolean): String;
var
  Expected: String;
begin
  Result := '';
  Expected := RemoveBackslashUnlessRoot(ExpandConstant('{#MyAppDir}'));
  if CompareText(RemoveBackslashUnlessRoot(ExpandConstant('{app}')), Expected) <> 0 then
    Result := 'Azookey can only be installed into ' + Expected + '.';
end;

// Older versions installed the settings app per user (%LOCALAPPDATA%\Azookey,
// registered under HKCU). Its uninstaller can be replaced without elevation,
// so it is run only as the original user, and not at all when that user's
// token is elevated (Setup started from an elevated process). Runs before the
// new per-machine copy is installed, which uses the same shortcut names.
<event('PrepareToInstall')>
function Azookey_RemovePerUserSettingsApp(var NeedsRestart: Boolean): String;
var
  Script: String;
  ResultCode: Integer;
begin
  Result := '';
  Script :=
    '$p = New-Object Security.Principal.WindowsPrincipal([Security.Principal.WindowsIdentity]::GetCurrent()); ' +
    'if ($p.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) { exit 0 }; ' +
    '$k = Get-ItemProperty -LiteralPath ''HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\{#MyAppName}'' -ErrorAction SilentlyContinue; ' +
    'if ($k -and $k.UninstallString) { ' +
    'Start-Process -FilePath $k.UninstallString.Trim([char]34) -ArgumentList ''/S'' -Wait }';
  try
    if not ExecAsOriginalUser(ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe'),
      '-NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "' + Script + '"', '',
      SW_HIDE, ewWaitUntilTerminated, ResultCode) then
      Log(Format('Failed to remove the per-user settings app: %s', [SysErrorMessage(ResultCode)]))
    else if ResultCode <> 0 then
      Log(Format('Removing the per-user settings app exited with code %d', [ResultCode]));
  except
    Log('Failed to remove the per-user settings app: ' + GetExceptionMessage);
  end;
end;

// Whether a dependency installer is the expected file: the settings app's
// installer must be the one built into this setup; anything downloaded (VC++
// runtimes, WebView2) must carry a valid Authenticode signature by Microsoft.
function Azookey_IsTrustedDependency(const Path: String): Boolean;
var
  QuotedPath: String;
  Script: String;
  ResultCode: Integer;
begin
  if CompareText(ExtractFileName(Path), '{#SettingsAppSetup}') = 0 then
  begin
    Result := CompareText(GetSHA256OfFile(Path), '{#SettingsAppSetupSha256}') = 0;
    Exit;
  end;

  QuotedPath := Path;
  StringChangeEx(QuotedPath, '''', '''''', True);
  Script := '$s = Get-AuthenticodeSignature -LiteralPath ''' + QuotedPath + '''; ' +
    'if ($s.Status -eq ''Valid'' -and $s.SignerCertificate.Subject -like ''CN=Microsoft Corporation,*'') { exit 0 }; ' +
    'exit 1';
  Result := Exec(ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe'),
    '-NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "' + Script + '"', '',
    SW_HIDE, ewWaitUntilTerminated, ResultCode) and (ResultCode = 0);
end;

function SetEnvironmentVariable(lpName, lpValue: String): Integer;
  external 'SetEnvironmentVariableW@kernel32.dll stdcall';

// Runs a dependency installer (CodeDependencies.iss) with Setup's
// administrator rights. Setup downloads or extracts it into {tmp}, which lies
// in the user's TEMP directory and is writable without elevation, so the file
// could be replaced before it is started. Copy it into a directory under {app}
// (Program Files; checked by Azookey_CheckAppDir) that only administrators
// and SYSTEM can access, check the copy there and run that. Not readable by
// users either: the file in {tmp} may have been replaced by a hard link to a
// file they must not read, whose copy would otherwise be readable until the
// check rejects it.
function Azookey_ExecuteDependency(const Filename, Parameters: String; var ResultCode: Integer): Boolean;
var
  Staging: String;
  Staged: String;
  AclResult: Integer;
  OldTmp: String;
  OldTemp: String;
begin
  Result := False;
  ResultCode := -1;
  Staging := RemoveBackslashUnlessRoot(ExpandConstant('{app}')) + '\setup-staging';
  Staged := Staging + '\' + ExtractFileName(Filename);
  if not ForceDirectories(Staging) then
  begin
    Log(Format('Failed to create %s', [Staging]));
    Exit;
  end;
  if not Exec(ExpandConstant('{sys}\icacls.exe'),
    '"' + Staging + '" /inheritance:r /grant:r *S-1-5-32-544:(OI)(CI)F *S-1-5-18:(OI)(CI)F', '',
    SW_HIDE, ewWaitUntilTerminated, AclResult) or (AclResult <> 0) then
  begin
    Log(Format('Failed to restrict access to %s', [Staging]));
    Exit;
  end;
  // A copy left behind by an interrupted setup.
  DeleteFile(Staged);
  if not CopyFile(Filename, Staged, True) then
  begin
    Log(Format('Failed to copy %s to %s', [Filename, Staged]));
    Exit;
  end;
  OldTmp := GetEnv('TMP');
  OldTemp := GetEnv('TEMP');
  try
    if Azookey_IsTrustedDependency(Staged) then
    begin
      // The installers unpack and load their own helpers (NSIS plugins, the
      // WebView2 runtime download) in TEMP; keep those out of the user's
      // reach as well.
      SetEnvironmentVariable('TMP', Staging);
      SetEnvironmentVariable('TEMP', Staging);
      Result := Exec(Staged, Parameters, '', SW_SHOWNORMAL, ewWaitUntilTerminated, ResultCode);
    end
    else
      Log(Format('%s is not the expected file; not running it', [Filename]));
  finally
    SetEnvironmentVariable('TMP', OldTmp);
    SetEnvironmentVariable('TEMP', OldTemp);
    DeleteFile(Staged);
    RemoveDir(Staging);
  end;
end;

#include "CodeDependencies.iss"

[Code]
const
  TASK_CREATE_OR_UPDATE = 6;
  TASK_LOGON_GROUP = 4;

function InitializeSetup: Boolean;
begin
  ExtractTemporaryFile('{#SettingsAppSetup}');
  Dependency_AddVC2015To2022x64;
  Dependency_AddVC2015To2022x86;
  // ui.exe and the settings app both need the WebView2 runtime. The settings
  // app's installer does not install it (webviewInstallMode skip): it would
  // download the bootstrapper to a fixed path in the user's TEMP directory and
  // run it with our rights.
  Dependency_AddWebView2;
  // NSIS installers take /S for a silent install; the previous /q was not
  // recognised, so the settings app's installer wizard opened and Setup
  // waited for it. The settings app is installed per machine next to the IME
  // (/D= must be the last parameter, unquoted); UninstallSettingsApp relies on
  // that location.
  Dependency_Add('{#SettingsAppSetup}',
    '/S /D=' + ExpandConstant('{#MyAppDir}'),
    'Azookey',
    '', '', True, False);

  Result := True;
end;

function UninstallNeedRestart(): Boolean;
begin
  Result := True;
end;

function CmdLineContains(Param: String): Boolean;
var
  I: Integer;
begin
  Result := False;
  for I := 1 to ParamCount do
  begin
    if CompareText(ParamStr(I), Param) = 0 then
    begin
      Result := True;
      Exit;
    end;
  end;
end;
function EscapeXmlText(Value: String): String;
begin
  Result := Value;
  StringChangeEx(Result, '&', '&amp;', True);
  StringChangeEx(Result, '<', '&lt;', True);
  StringChangeEx(Result, '>', '&gt;', True);
end;

procedure ReplaceTaskPlaceholder(
  var Lines: TArrayOfString;
  Placeholder: String;
  Value: String
);
var
  I: Integer;
begin
  for I := 0 to GetArrayLength(Lines) - 1 do
    StringChangeEx(Lines[I], Placeholder, Value, True);
end;

// Registers the startup task through the Task Scheduler COM API. The XML is
// passed as a string: schtasks /XML reads the file as UTF-16 and rejects a
// UTF-8 file or declaration ("The task XML is malformed").
procedure RegisterStartupTask();
var
  TaskXmlPath: String;
  TaskXmlLines: TArrayOfString;
  TaskXml: String;
  I: Integer;
  Service: Variant;
  Folder: Variant;
  Task: Variant;
begin
  ExtractTemporaryFile('Azookey Startup.xml');
  TaskXmlPath := ExpandConstant('{tmp}\Azookey Startup.xml');

  if not LoadStringsFromFile(TaskXmlPath, TaskXmlLines) then
    RaiseException('Failed to read the startup task template.');

  ReplaceTaskPlaceholder(TaskXmlLines, 'PATH_TO_LAUNCHER',
    EscapeXmlText(ExpandConstant('{app}\launcher.exe')));
  ReplaceTaskPlaceholder(TaskXmlLines, 'PATH_TO_APP',
    EscapeXmlText(ExpandConstant('{app}')));

  TaskXml := '';
  for I := 0 to GetArrayLength(TaskXmlLines) - 1 do
    TaskXml := TaskXml + TaskXmlLines[I] + #13#10;

  // Optional COM arguments must be VT_EMPTY (Unassigned); RegisterTask
  // rejects VT_NULL.
  Service := CreateOleObject('Schedule.Service');
  Service.Connect();
  Folder := Service.GetFolder('\');
  Task := Folder.RegisterTask('Azookey Startup', TaskXml,
    TASK_CREATE_OR_UPDATE, Unassigned, Unassigned, TASK_LOGON_GROUP);
  Task.Run(Unassigned);
end;

// Uninstalls the settings app, which the NSIS installer put into {app}. Never
// run an uninstaller found through HKCU here: that value and a per-user
// install are writable without elevation. _?= keeps the NSIS uninstaller from
// copying itself to the user's TEMP directory and running from there; it then
// cannot delete itself, so that is done here.
procedure UninstallSettingsApp();
var
  AppDir: String;
  Uninstaller: String;
  ResultCode: Integer;
begin
  AppDir := RemoveBackslashUnlessRoot(ExpandConstant('{app}'));
  Uninstaller := AppDir + '\uninstall.exe';
  if not FileExists(Uninstaller) then
    Exit;
  // The NSIS uninstaller is interactive unless run with /S; hidden, its
  // confirmation page would never be answered.
  if not Exec(Uninstaller, '/S _?=' + AppDir, '', SW_HIDE, ewWaitUntilTerminated, ResultCode) then
    Log(Format('Failed to start the settings app uninstaller: %s', [SysErrorMessage(ResultCode)]))
  else if ResultCode <> 0 then
    Log(Format('Settings app uninstaller exited with code %d', [ResultCode]));
  DeleteFile(Uninstaller);
end;

// Stops the startup task and the launcher/server/UI processes started from Dir
// so their files can be replaced or deleted. Matches on the executable path
// because the image names (ui.exe, launcher.exe) are generic. The launcher
// restarts the server and the UI whenever they exit, so it is stopped (and
// waited for) first.
procedure StopAzookeyProcesses(Dir: String);
var
  PsDir: String;
  Script: String;
  ResultCode: Integer;
begin
  Exec(ExpandConstant('{sys}\schtasks.exe'), '/End /TN "Azookey Startup"', '',
    SW_HIDE, ewWaitUntilTerminated, ResultCode);

  PsDir := RemoveBackslashUnlessRoot(Dir);
  StringChangeEx(PsDir, '''', '''''', True);
  Script := '$dir = ''' + PsDir + '\''; ' +
    '$stop = { param($names) ' +
    '$p = @(Get-Process -Name $names -ErrorAction SilentlyContinue | ' +
    'Where-Object { $_.Path -and $_.Path.StartsWith($dir, [StringComparison]::OrdinalIgnoreCase) }); ' +
    '$p | Stop-Process -Force; ' +
    '$p | Wait-Process -Timeout 10 -ErrorAction SilentlyContinue }; ' +
    '& $stop launcher; ' +
    '& $stop azookey-server,ui';
  Exec(ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe'),
    '-NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "' + Script + '"', '',
    SW_HIDE, ewWaitUntilTerminated, ResultCode);
end;

function PreviousInstallDir(): String;
begin
  if not RegQueryStringValue(HKLM,
    'Software\Microsoft\Windows\CurrentVersion\Uninstall\{80B746D4-D74D-4345-8F81-47E06BCAB515}_is1',
    'Inno Setup: App Path', Result) then
    Result := '';
end;

procedure DeleteOrScheduleFile(Path: String);
begin
  if FileExists(Path) and not DeleteFile(Path) then
    RestartReplace(Path, '');
end;

const
  LEGACY_FILES = 'azookey.dll,azookey32.dll,azookey_windows.dll,azookey-server.dll,azookey-server.exe,launcher.exe,ui.exe,zenz.gguf,launch.vbs,unins000.exe,unins000.dat,unins000.msg';
  LEGACY_DIRS = 'x86,llama_cpu,llama_cuda,llama_vulkan,Dictionary,EmojiDictionary';

// Whether Dir is inside Program Files, where only administrators can create
// junctions or symbolic links. Anywhere else (the old default
// %APPDATA%\Azookey, or a custom directory, which inherits write access for
// users from e.g. C:\) a non-elevated user can redirect a path, and every
// deletion with Setup's rights, or scheduled for SYSTEM with RestartReplace,
// could then hit a file of the user's choosing.
function IsInProgramFiles(Dir: String): Boolean;
var
  Path: String;
begin
  Path := Lowercase(AddBackslash(Dir));
  Result := (Pos(Lowercase(AddBackslash(ExpandConstant('{commonpf64}'))), Path) = 1) or
    (Pos(Lowercase(AddBackslash(ExpandConstant('{commonpf32}'))), Path) = 1);
end;

// Joins Items (comma-separated) as a PowerShell array of single-quoted strings.
function PsStringArray(Items: String): String;
begin
  Result := Items;
  StringChangeEx(Result, '''', '''''', True);
  StringChangeEx(Result, ',', ''',''', True);
  Result := '@(''' + Result + ''')';
end;

// Deletes the legacy files in a directory the user can write to, as the
// original (non-elevated) user, who owns them; the user's own rights cannot
// be escalated by redirecting a path. Files still in use (the IME DLLs loaded
// by running applications) are deleted at the user's next logon through
// HKCU RunOnce, again with the user's rights. Nothing is done when the
// original user's token is elevated (Setup started from an elevated process);
// the files left behind are no longer registered or started.
procedure RemoveUserWritableLegacyInstall(Dir: String; AllFiles: Boolean);
var
  PsDir: String;
  Script: String;
  ResultCode: Integer;
begin
  PsDir := Dir;
  StringChangeEx(PsDir, '''', '''''', True);
  Script :=
    '$p = New-Object Security.Principal.WindowsPrincipal([Security.Principal.WindowsIdentity]::GetCurrent()); ' +
    'if ($p.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) { exit 2 }; ' +
    '$d = ''' + PsDir + '''; ' +
    '$files = @(' + PsStringArray(LEGACY_FILES) + ' | ForEach-Object { Join-Path $d $_ }); ';
  if AllFiles then
    Script := Script +
      '$files += @(Get-ChildItem -LiteralPath $d -File -ErrorAction SilentlyContinue | ' +
      'Where-Object { $_.Extension -in ''.exe'',''.dll'' } | ForEach-Object { $_.FullName }); ' +
      PsStringArray(LEGACY_DIRS) + ' | ForEach-Object { ' +
      'Remove-Item -LiteralPath (Join-Path $d $_) -Recurse -Force -ErrorAction SilentlyContinue }; ';
  Script := Script +
    '$ro = ''HKCU:\Software\Microsoft\Windows\CurrentVersion\RunOnce''; ' +
    '$cmd = Join-Path ([Environment]::SystemDirectory) ''cmd.exe''; ' +
    '$i = 0; ' +
    'foreach ($f in ($files | Select-Object -Unique)) { ' +
    'if (-not (Test-Path -LiteralPath $f -PathType Leaf)) { continue }; ' +
    'try { Remove-Item -LiteralPath $f -Force -ErrorAction Stop } catch { ' +
    '$i++; ' +
    'if (-not (Test-Path -LiteralPath $ro)) { New-Item -Path $ro -Force | Out-Null }; ' +
    'Set-ItemProperty -LiteralPath $ro -Name (''AzookeyLegacyCleanup'' + $i) ' +
    '-Value ($cmd + '' /c del /f /q '' + [char]34 + $f + [char]34) } }';
  try
    if not ExecAsOriginalUser(ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe'),
      '-NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "' + Script + '"', '',
      SW_HIDE, ewWaitUntilTerminated, ResultCode) then
      Log(Format('Failed to remove the legacy install in %s: %s', [Dir, SysErrorMessage(ResultCode)]))
    else if ResultCode = 2 then
      Log(Format('Not removing the legacy install in %s: the original user is elevated', [Dir]))
    else if ResultCode <> 0 then
      Log(Format('Removing the legacy install in %s exited with code %d', [Dir, ResultCode]));
  except
    Log(Format('Failed to remove the legacy install in %s: %s', [Dir, GetExceptionMessage]));
  end;
end;

// Removes the program files of an install in another directory by deleting
// Azookey's own binaries by name: with Setup's rights only inside Program
// Files, as the original user anywhere else (RemoveUserWritableLegacyInstall).
// The IME is not unregistered with the old DLLs: the old default directory is
// writable by the user, so regsvr32 would load whatever DLL is there with
// administrator rights. Registering the new DLLs (same CLSID, profile and
// categories) overwrites those entries. The wildcard/subdirectory cleanup
// (Swift runtime DLLs, llama backends, dictionaries) runs only for the old
// default %APPDATA%\Azookey, which belongs to Azookey alone; a custom directory
// may contain other applications' files. %APPDATA%\Azookey also holds
// settings.json and the learning memory, which are kept.
procedure RemoveLegacyInstall(Dir: String);
var
  Files: TArrayOfString;
  I: Integer;
begin
  if not IsInProgramFiles(Dir) then
  begin
    RemoveUserWritableLegacyInstall(Dir,
      CompareText(Dir, ExpandConstant('{userappdata}\{#MyAppName}')) = 0);
    Exit;
  end;

  Files := StringSplit(LEGACY_FILES, [','], stExcludeEmpty);
  for I := 0 to GetArrayLength(Files) - 1 do
    DeleteOrScheduleFile(Dir + '\' + Files[I]);
end;

<event('PrepareToInstall')>
function Azookey_PrepareToInstall(var NeedsRestart: Boolean): String;
var
  AppDir: String;
  OldDir: String;
begin
  Result := '';
  AppDir := RemoveBackslashUnlessRoot(ExpandConstant('{app}'));
  StopAzookeyProcesses(AppDir);

  OldDir := RemoveBackslashUnlessRoot(PreviousInstallDir());
  if (OldDir <> '') and (CompareText(OldDir, AppDir) <> 0) and DirExists(OldDir) then
  begin
    StopAzookeyProcesses(OldDir);
    RemoveLegacyInstall(OldDir);
  end;
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssPostInstall then
  begin
    // Remove the legacy script before replacing the scheduled task.
    DeleteFile(ExpandConstant('{app}\launch.vbs'));
    RegisterStartupTask();
  end;
end;

procedure CurPageChanged(CurPageID: Integer);
begin
  if CurPageID = wpFinished then
    WizardForm.RunList.Visible := False;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usUninstall then
  begin
    // Release launcher/server/UI files before they are deleted.
    StopAzookeyProcesses(ExpandConstant('{app}'));
    // Remove the settings app's files before Uninstall removes {app}.
    UninstallSettingsApp();
  end;
end;